---
const apps = [
	{
		name: '纸小记',
		description: '热敏打印工具 App 的用户协议与隐私政策。',
		href: '/zh-hans/legal/zhixiaoji/',
	},
];
---

<!doctype html>
<html lang="zh-Hans">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>协议中心 | 启枢科技</title>
		<meta name="description" content="启枢科技应用协议中心，集中展示各 App 的用户服务协议与隐私政策。" />
		<link rel="icon" href="/logo-light.png" type="image/png" />
		<style>
			body {
				margin: 0;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
				color: #07142f;
				background:
					linear-gradient(rgba(36, 174, 226, 0.06) 1px, transparent 1px),
					linear-gradient(90deg, rgba(36, 174, 226, 0.06) 1px, transparent 1px),
					linear-gradient(135deg, #fff8ff 0%, #eefaff 55%, #f7fbff 100%);
				background-size: 28px 28px, 28px 28px, auto;
			}

			main {
				width: min(920px, calc(100% - 32px));
				margin: 76px auto;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			h1 {
				margin: 0 0 18px;
				font-size: clamp(48px, 9vw, 88px);
				line-height: 0.98;
				color: #42bdeb;
				text-shadow: 4px 5px 0 #f3cf3d, 8px 9px 0 #081431;
			}

			.lead {
				max-width: 660px;
				color: #4c5870;
				font-size: 18px;
				font-weight: 600;
				line-height: 1.75;
			}

			.grid {
				display: grid;
				gap: 18px;
				margin-top: 38px;
			}

			.card {
				display: grid;
				gap: 10px;
				padding: 26px;
				border: 2px solid rgba(36, 174, 226, 0.32);
				background: rgba(255, 255, 255, 0.86);
				box-shadow: 12px 12px 0 rgba(36, 174, 226, 0.12);
			}

			.card strong {
				font-size: 24px;
			}

			.card span {
				color: #4c5870;
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-top: 12px;
			}

			.links a {
				padding: 10px 14px;
				border: 2px solid rgba(36, 174, 226, 0.38);
				background: rgba(255, 255, 255, 0.72);
				font-weight: 800;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>协议中心</h1>
			<p class="lead">这里集中放置启枢科技旗下应用的服务协议、用户协议、隐私政策和后续可能新增的合规说明。</p>
			<section class="grid">
				{apps.map((app) => (
					<article class="card">
						<strong>{app.name}</strong>
						<span>{app.description}</span>
						<div class="links">
							<a href={app.href}>查看协议</a>
							<a href={`${app.href}terms/`}>用户服务协议</a>
							<a href={`${app.href}privacy/`}>隐私政策</a>
						</div>
					</article>
				))}
			</section>
		</main>
	</body>
</html>
