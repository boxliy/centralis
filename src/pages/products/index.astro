---
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Product introduction pages." />
		<title>Products</title>
		<link rel="icon" href="/logo-light.png" type="image/png" media="(prefers-color-scheme: light)" />
		<link rel="icon" href="/logo-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
	</head>
	<body>
		<header>
			<a class="brand" href="/" aria-label="Home">
				<img class="logo logo-light" src="/logo-light.png" alt="" width="36" height="36" />
				<img class="logo logo-dark" src="/logo-dark.png" alt="" width="36" height="36" />
			</a>
			<nav aria-label="Primary navigation">
				<a href="/">Home</a>
				<a href="/docs/">Docs</a>
			</nav>
		</header>

		<main>
			<p class="eyebrow">Products</p>
			<h1>Product pages will live here.</h1>
			<p>
				This route is intentionally simple for now. It gives product introductions a clean Astro surface
				outside the documentation layout, ready to be expanded when the product content is available.
			</p>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
		--bg: #f7f8fa;
		--text: #14161a;
		--muted: #626873;
		--border: #d9dde5;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #121418;
			--text: #f3f5f8;
			--muted: #a8afba;
			--border: #2b3039;
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		color: var(--text);
		background: var(--bg);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	header,
	main {
		max-width: 960px;
		margin: 0 auto;
		padding-inline: 1.5rem;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--border);
	}

	.brand,
	.logo {
		display: block;
	}

	.logo-dark {
		display: none;
	}

	nav {
		display: flex;
		gap: 1rem;
		color: var(--muted);
	}

	main {
		padding-block: 6rem;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 720px;
		margin: 0;
		font-size: clamp(3rem, 8vw, 5.5rem);
		line-height: 1;
		letter-spacing: 0;
	}

	p {
		max-width: 620px;
		color: var(--muted);
		font-size: 1.1rem;
		line-height: 1.7;
	}

	@media (prefers-color-scheme: dark) {
		.logo-light {
			display: none;
		}

		.logo-dark {
			display: block;
		}
	}
</style>
