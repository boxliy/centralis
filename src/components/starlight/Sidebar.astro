function isActiveGroup(group: (typeof groups)[number]) {
	return group.items.some((item) => !('section' in item) && currentSlug === item.slug);
}
---

<aside class="sidebar" aria-label={t.head} data-docs-nav data-collapse-label={t.collapse} data-expand-label={t.expand}>
	<div class="sidebar-head">
		<span class="sidebar-title">{t.head}</span>
		<button class="sidebar-toggle" type="button" aria-label={t.collapse} aria-pressed="false">{t.collapse}</button>
	</div>
	{groups.map((group) => (
		<details class="nav-section" open={isActiveGroup(group)}>
			<summary>{group.label}</summary>
			<div class="nav-list">
				{group.items.map((item) => (
					'section' in item
						? <div class="doc-link-section">{item.section}</div>
						: <a class:list={['doc-link', { active: currentSlug === item.slug, child: item.child }]} href={href(item.slug)} data-code={item.code} data-title={item.label} aria-current={currentSlug === item.slug ? 'page' : undefined}>{item.label}</a>
				))}
			</div>
		</details>
	))}
</aside>

<script>
	const navStorageKey = 'qishu-docs-nav-collapsed';

	function syncDocsNav(nav: HTMLElement, collapsed: boolean): void {
		const layout = nav.closest('.docs-layout');
		layout?.classList.toggle('nav-collapsed', collapsed);

		const toggle = nav.querySelector<HTMLButtonElement>('.sidebar-toggle');
		if (!toggle) return;
		const label = collapsed ? nav.dataset.expandLabel || 'Expand' : nav.dataset.collapseLabel || 'Fold';
		toggle.textContent = label;
		toggle.setAttribute('aria-label', label);
		toggle.setAttribute('aria-pressed', String(collapsed));
	}

	function setupDocsNav(nav: HTMLElement): void {
		if (nav.dataset.ready === 'true') return;
		nav.dataset.ready = 'true';

		let collapsed = false;
		try {
			collapsed = localStorage.getItem(navStorageKey) === 'true';
		} catch {
			collapsed = false;
		}
		syncDocsNav(nav, collapsed);

		nav.querySelector('.sidebar-toggle')?.addEventListener('click', () => {
			const next = !nav.closest('.docs-layout')?.classList.contains('nav-collapsed');
			syncDocsNav(nav, next);
			try {
				localStorage.setItem(navStorageKey, String(next));
			} catch {
				// Navigation width is a visual preference only.
			}
		});
	}

	document.querySelectorAll<HTMLElement>('[data-docs-nav]').forEach(setupDocsNav);
</script>
