---
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';

const locale = Astro.locals.starlightRoute.locale || 'root';
const prefix = locale === 'root' ? '' : `/${locale}`;
const homeHref = prefix ? `${prefix}/` : '/';
const nav = {
	root: [['Home', homeHref], ['Docs', `${prefix}/docs/`], ['Contact', '#wechat-contact']],
	'zh-hans': [['官网', homeHref], ['文档', `${prefix}/docs/`], ['联系', '#wechat-contact']],
	'zh-hant': [['官網', homeHref], ['文檔', `${prefix}/docs/`], ['聯絡', '#wechat-contact']],
	ko: [['홈', homeHref], ['문서', `${prefix}/docs/`], ['문의', '#wechat-contact']],
	ja: [['公式サイト', homeHref], ['ドキュメント', `${prefix}/docs/`], ['お問い合わせ', '#wechat-contact']],
};
const navItems = nav[locale as keyof typeof nav] ?? nav.root;
---

<div class="nav-inner">
	<a class="brand" href={homeHref} aria-label="Qishu Technology homepage">
		<img class="brand-logo brand-logo-light" src="/logo-light.png" alt="启枢科技" width="44" height="44" />
		<img class="brand-logo brand-logo-dark" src="/logo-dark.png" alt="启枢科技" width="44" height="44" />
	</a>
	<nav class="nav-links" aria-label="頁面區段">
		{navItems.map(([label, href]) => <a href={href}>{label}</a>)}
	</nav>
	<div class="od-controls">
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>
