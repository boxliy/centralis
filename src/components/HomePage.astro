---
import { defaultLocale, getHomeCopy, getLocalePath, localeLabels, locales, type Locale, withProductAssets } from '../i18n/home';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getHomeCopy(locale);
const products = withProductAssets(locale);
const localePathMap = Object.fromEntries(locales.map((item) => [item, getLocalePath(item)]));
const languageOptions = locales.map((item) => ({ locale: item, label: localeLabels[item], href: getLocalePath(item), active: item === locale }));
const siteOrigin = Astro.site ?? new URL('https://qishusolution.com');
const canonicalUrl = new URL(getLocalePath(locale), siteOrigin).href;
const socialImageUrl = new URL('/hero/qishu-printer-ecosystem-light.webp', siteOrigin).href;
const hreflangMap: Record<Locale, string> = {
	en: 'en',
	'zh-hans': 'zh-Hans',
	'zh-hant': 'zh-Hant',
	ko: 'ko',
	ja: 'ja',
};
const ogLocaleMap: Record<Locale, string> = {
	en: 'en_US',
	'zh-hans': 'zh_CN',
	'zh-hant': 'zh_TW',
	ko: 'ko_KR',
	ja: 'ja_JP',
};
const keywordsMap: Record<Locale, string> = {
	en: 'thermal printer development, printer SDK, PCBA, firmware development, printer app, label printer, embedded software, production coordination',
	'zh-hans': '热敏打印机开发, 打印机SDK, PCBA, 固件开发, 打印机App, 标签打印机, 嵌入式软件, 量产协作',
	'zh-hant': '熱敏打印機開發, 打印機SDK, PCBA, 固件開發, 打印機App, 標籤打印機, 嵌入式軟體, 量產協作',
	ko: '감열 프린터 개발, 프린터 SDK, PCBA, 펌웨어 개발, 프린터 앱, 라벨 프린터, 임베디드 소프트웨어, 양산 협업',
	ja: '感熱プリンター開発, プリンターSDK, PCBA, ファームウェア開発, プリンターアプリ, ラベルプリンター, 組み込みソフトウェア, 量産連携',
};
const alternateLinks = locales.map((item) => ({ locale: hreflangMap[item], href: new URL(getLocalePath(item), siteOrigin).href }));
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: locale === 'en' ? 'Qishu Technology' : '启枢科技',
		legalName: t.footer.company,
		url: siteOrigin.href,
		logo: new URL('/logo-light.png', siteOrigin).href,
		email: 'hello@qishusolution.com',
		sameAs: ['https://github.com/boxliy/centralis'],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: locale === 'en' ? 'Qishu Technology' : '启枢科技',
		url: siteOrigin.href,
		inLanguage: t.lang,
		publisher: {
			'@type': 'Organization',
			name: locale === 'en' ? 'Qishu Technology' : '启枢科技',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: t.meta.title,
		description: t.meta.description,
		serviceType: 'Thermal printing product development',
		provider: {
			'@type': 'Organization',
			name: locale === 'en' ? 'Qishu Technology' : '启枢科技',
			url: siteOrigin.href,
		},
		areaServed: 'Worldwide',
	},
];
const moduleEntries = t.product.tabs.map(([key, label]) => ({ key, label, module: t.product.modules[key] }));
const defaultModule = moduleEntries[0];
const planEntries = Object.entries(t.pricing.plans);
const defaultPlan = planEntries[0][1];
const moduleData = Object.fromEntries(moduleEntries.map((entry) => [entry.key, entry.module]));
const planData = Object.fromEntries(planEntries);
const contactEmail = 'hello@qishusolution.com';
---

<!doctype html>
<html lang={t.lang} dir={t.dir} data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={t.meta.description} />
		<meta name="keywords" content={keywordsMap[locale]} />
		<meta name="author" content={t.footer.company} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#0a0e27" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#f3f7ff" media="(prefers-color-scheme: light)" />
		<title>{t.meta.title}</title>
		<link rel="canonical" href={canonicalUrl} />
		{alternateLinks.map((item) => <link rel="alternate" hreflang={item.locale} href={item.href} />)}
		<link rel="alternate" hreflang="x-default" href={new URL('/', siteOrigin).href} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={locale === 'en' ? 'Qishu Technology' : '启枢科技'} />
		<meta property="og:title" content={t.meta.title} />
		<meta property="og:description" content={t.meta.description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content={t.aria.heroProduct} />
		<meta property="og:locale" content={ogLocaleMap[locale]} />
		{locales.filter((item) => item !== locale).map((item) => <meta property="og:locale:alternate" content={ogLocaleMap[item]} />)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={t.meta.title} />
		<meta name="twitter:description" content={t.meta.description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<link rel="icon" href="/logo-light.png" type="image/png" media="(prefers-color-scheme: light)" />
		<link rel="icon" href="/logo-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
		<script is:inline src="/qishu-preferences.js"></script>
		<script is:inline define:vars={{ locale, localePathMap }}>
			(() => {
				const aliases = { zh: 'zh-hans', cn: 'zh-hans', 'zh-cn': 'zh-hans', 'zh-hans': 'zh-hans', tw: 'zh-hant', 'zh-tw': 'zh-hant', 'zh-hant': 'zh-hant', en: 'en', ko: 'ko', kr: 'ko', ja: 'ja', jp: 'ja' };
				const url = new URL(window.location.href);
				const raw = url.searchParams.get('hl');
				const target = raw ? aliases[raw.toLowerCase()] : null;
				const targetPath = target ? localePathMap[target] : null;
				if (target && targetPath) {
					window.location.replace(targetPath + window.location.hash);
				}
			})();
		</script>
	</head>
	<body>
		<canvas class="gravity-grid" aria-hidden="true"></canvas>
		<div class="site">
			<header class="nav" aria-label={t.aria.mainNav}>
				<div class="nav-inner">
					<a class="brand" href="#top" aria-label={t.aria.brand}>
						<img class="brand-logo brand-logo-light" src="/logo-light.png" alt="启枢科技" width="44" height="44" />
						<img class="brand-logo brand-logo-dark" src="/logo-dark.png" alt="启枢科技" width="44" height="44" />
					</a>
					<nav class="nav-links" aria-label={t.aria.sections}>
						{t.nav.map(([label, href]) => <a href={href}>{label}</a>)}
					</nav>
					<div class="select-switch theme-switch" data-theme-switch>
						<button class="select-trigger theme-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label={t.aria.theme}><span data-theme-label>{t.theme.system}</span></button>
						<div class="select-menu theme-menu" role="listbox" aria-label={t.aria.theme}>
							<button class="select-option theme-option active" type="button" role="option" aria-selected="true" data-theme-option="system"><span data-theme-option-label="system">{t.theme.system}</span></button>
							<button class="select-option theme-option" type="button" role="option" aria-selected="false" data-theme-option="light"><span data-theme-option-label="light">{t.theme.light}</span></button>
							<button class="select-option theme-option" type="button" role="option" aria-selected="false" data-theme-option="dark"><span data-theme-option-label="dark">{t.theme.dark}</span></button>
						</div>
					</div>
					<div class="select-switch language-switch" data-language-switch>
						<button class="select-trigger language-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label={t.aria.language}><span data-lang-label>{localeLabels[locale]}</span></button>
						<div class="select-menu language-menu" role="listbox" aria-label={t.aria.language}>
							{languageOptions.map((option) => (
								<a class:list={['select-option', 'language-option', { active: option.active }]} role="option" aria-selected={String(option.active)} href={option.href} data-lang={option.locale}>{option.label}</a>
							))}
						</div>
					</div>
					<a class="pixel-btn nav-cta" href="#contact">{t.header.cta}</a>
				</div>
			</header>

			<main id="top">
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-text reveal">
						<div class="eyebrow">{t.hero.eyebrow}</div>
						<h1 id="hero-title">{t.hero.title}</h1>
						<p class="hero-copy">{t.hero.copy}</p>
						<div class="hero-actions">
							<a class="pixel-btn" href="#product">{t.hero.primary}</a>
							<a class="pixel-btn alt" href="#contact">{t.hero.secondary}</a>
							<span class="hero-note">{t.hero.note}</span>
						</div>
					</div>

					<div class="terminal reveal" aria-label={t.aria.terminal}>
						<span class="corner" aria-hidden="true"></span>
						<div class="terminal-top">
							<span>{t.hero.console}</span>
							<span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
						</div>
						<div class="dashboard">
							<div class="status-grid">
								{t.hero.stats.map(([label, value]) => <div class="stat"><strong>{label}</strong><span>{value}</span></div>)}
							</div>
							<div class="signal" id="hero-signal" aria-label={t.aria.signal}>
								{t.hero.signals.map(([label, value, width]) => <div class="signal-row"><span>{label}</span><div class="bar"><span style={`--w: ${width}`}></span></div><b>{value}</b></div>)}
							</div>
							<div class="hero-product" aria-label={t.aria.heroProduct}>
								<span class="product-corner tl" aria-hidden="true"></span>
								<span class="product-corner tr" aria-hidden="true"></span>
								<span class="product-corner br" aria-hidden="true"></span>
								<span class="product-corner bl" aria-hidden="true"></span>
								<div class="product-visual" aria-hidden="true">
									<div class="desktop"><span></span><b></b></div>
									<div class="board"><span></span><span></span><span></span></div>
									<div class="printer"><span class="printer-slot"></span><span class="paper-roll"></span><span class="print-line"></span></div>
									<div class="phone"><span></span><b></b></div>
									<div class="link l1"></div><div class="link l2"></div><div class="link l3"></div>
								</div>
								<img
									class="hero-product-image"
									src="/hero/qishu-printer-ecosystem-dark.webp"
									data-dark-src="/hero/qishu-printer-ecosystem-dark.webp"
									data-light-src="/hero/qishu-printer-ecosystem-light.webp"
									alt=""
									decoding="async"
									fetchpriority="high"
									onload="this.dataset.loaded='true';(function(img){if(img.dataset.themeSwitcherReady)return;img.dataset.themeSwitcherReady='true';var apply=function(){var isLight=document.documentElement.getAttribute('data-theme')==='light';var next=img.getAttribute(isLight?'data-light-src':'data-dark-src');if(next&&img.getAttribute('src')!==next){delete img.dataset.loaded;img.setAttribute('src',next);}};apply();new MutationObserver(apply).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});})(this)"
								/>
								<div class="product-legend">{t.hero.productLegend}</div>
							</div>
						</div>
					</div>
				</section>

				<div class="trust-strip" id="trust" aria-label={t.aria.mainNav}>
					{t.trust.map(([title, copy]) => <div class="trust-item reveal"><strong>{title}</strong><span>{copy}</span></div>)}
				</div>

				<section id="features" aria-labelledby="features-title">
					<div class="section-head reveal">
						<h2 id="features-title">{t.features.title}</h2>
						<p>{t.features.copy}</p>
					</div>
					<div class="cards">
						{t.features.cards.map((card) => <article class="card reveal"><div class:list={['icon', card.icon]} aria-hidden="true"></div><h3>{card.title}</h3><p>{card.copy}</p><ul>{card.items.map((item) => <li>{item}</li>)}</ul></article>)}
					</div>
				</section>

				<section class="product-rail" id="gallery" aria-labelledby="gallery-title">
					<div class="section-head reveal">
						<h2 id="gallery-title">{t.gallery.title}</h2>
						<p id="gallery-copy">{t.gallery.copy}</p>
					</div>
					<div class="rail-shell reveal" aria-label={t.aria.gallery}>
						<div class="rail-viewport" data-product-rail tabindex="0">
							<div class="rail-track" data-product-track>
								{products.map((product) => <article class="product-card" tabindex="0"><div class="product-media"><div class:list={['product-shot', product.shot]} aria-hidden="true"><span></span><span></span><span></span></div><img class="product-image" src={product.image} alt={product.alt} loading="lazy" onload="this.dataset.loaded='true'" /><span class="product-tag">{product.tag}</span></div><div class="product-caption"><h3>{product.title}</h3><p>{product.copy}</p></div></article>)}
							</div>
						</div>
					</div>
					<p class="rail-hint">{t.gallery.hint}</p>
				</section>

				<section id="workflow" aria-labelledby="workflow-title">
					<div class="section-head reveal"><h2 id="workflow-title">{t.workflow.title}</h2><p>{t.workflow.copy}</p></div>
					<div class="steps reveal">
						{t.workflow.steps.map(([code, title, copy]) => <article class="step"><b>{code}</b><h3>{title}</h3><p>{copy}</p></article>)}
					</div>
				</section>

				<section id="product" aria-labelledby="product-title">
					<div class="section-head reveal"><h2 id="product-title">{t.product.title}</h2><p>{t.product.copy}</p></div>
					<div class="product">
						<div class="control-panel reveal">
							<div class="eyebrow">{t.product.eyebrow}</div>
							<h3>{t.product.selectTitle}</h3>
							<div class="tabs" role="tablist" aria-label={t.aria.moduleTabs}>
								{moduleEntries.map((entry, index) => <button class="tab" type="button" role="tab" aria-selected={String(index === 0)} data-module={entry.key}>{entry.label}</button>)}
							</div>
							<p class="panel-copy" id="module-copy">{defaultModule.module.copy}</p>
							<div class="handoff-flow" id="module-flow" aria-label={t.aria.moduleFlow}>
								{defaultModule.module.flow.map(([label, value]) => <div class="flow-item"><span>{label}</span><strong>{value}</strong></div>)}
							</div>
						</div>
						<div class="preview-panel reveal">
							<div class="screen" aria-label={t.aria.modulePreview}>
								<div class="screen-head"><span id="screen-label">{defaultModule.module.label}</span><span>{t.product.online}</span></div>
								<div class="mini-grid" id="module-grid">
									{defaultModule.module.grid.map(([title, copy]) => <div class="mini"><strong>{title}</strong><span>{copy}</span></div>)}
								</div>
								<div class="screen-foot"><span>{t.product.foot}</span><span id="screen-status">{defaultModule.module.status}</span></div>
							</div>
						</div>
					</div>
				</section>

				<section aria-labelledby="proof-title">
					<div class="section-head reveal"><h2 id="proof-title">{t.proof.title}</h2><p>{t.proof.copy}</p></div>
					<div class="proof">
						<blockquote class="quote reveal"><p>{t.proof.quote}</p><cite>{t.proof.cite}</cite></blockquote>
						<div class="use-cases">
							{t.proof.cases.map(([title, copy]) => <article class="case reveal"><h3>{title}</h3><p>{copy}</p></article>)}
						</div>
					</div>
				</section>

				<section aria-labelledby="journey-title">
					<div class="section-head reveal"><h2 id="journey-title">{t.journey.title}</h2><p>{t.journey.copy}</p></div>
					<div class="journey">
						{t.journey.cards.map(([code, title, copy]) => <article class="journey-card reveal"><b>{code}</b><h3>{title}</h3><p>{copy}</p></article>)}
					</div>
				</section>

				<section id="pricing" aria-labelledby="pricing-title">
					<div class="section-head reveal"><h2 id="pricing-title">{t.pricing.title}</h2><p>{t.pricing.copy}</p></div>
					<div class="pricing reveal">
						<div><div class="eyebrow">{t.pricing.eyebrow}</div><h3>{t.pricing.selectTitle}</h3><div class="switch" aria-label={t.aria.planSwitch}>{planEntries.map(([key, plan], index) => <button type="button" class:list={{ active: index === 0 }} data-plan={key}>{plan[0]}</button>)}</div></div>
						<article class="plan" id="plan-card"><div class="price" id="plan-price">{defaultPlan[1]}</div><p id="plan-desc">{defaultPlan[2]}</p><ul id="plan-list">{defaultPlan[3].map((item) => <li>{item}</li>)}</ul><a class="pixel-btn" href="#contact">{t.pricing.consult}</a></article>
					</div>
				</section>

				<section aria-labelledby="faq-title">
					<div class="section-head reveal"><h2 id="faq-title">{t.faq.title}</h2><p>{t.faq.copy}</p></div>
					<div class="faq reveal">
						{t.faq.items.map(([question, answer], index) => <div class:list={['faq-item', { open: index === 0 }]}><button type="button" aria-expanded={String(index === 0)}><span>{question}</span><span>{index === 0 ? '-' : '+'}</span></button><div class="faq-panel">{answer}</div></div>)}
					</div>
				</section>

				<section id="contact" aria-labelledby="contact-title">
					<div class="contact">
						<div class="reveal"><div class="eyebrow">{t.contact.eyebrow}</div><h2 id="contact-title">{t.contact.title}</h2><p class="hero-copy">{t.contact.copy}</p><div class="copy-line"><span>{t.contact.emailIntro}</span><button class="copy-email" type="button" data-copy={contactEmail}>{t.contact.copyEmail}</button></div></div>
						<form class="contact-form reveal" novalidate>
							<label>{t.contact.name}<input name="name" autocomplete="name" placeholder={t.contact.namePlaceholder} required /></label>
							<label>{t.contact.email}<input name="email" type="email" autocomplete="email" placeholder={t.contact.emailPlaceholder} required /></label>
							<div class="choice-field" role="radiogroup" aria-label={t.aria.needType}><span>{t.contact.need}</span><div class="choice-grid">{t.contact.needs.map(([value, label], index) => <label class="choice"><input type="radio" name="need" value={value} checked={index === 0} />{label}</label>)}</div></div>
							<label>{t.contact.message}<textarea name="message" placeholder={t.contact.messagePlaceholder} required></textarea></label>
							<button class="pixel-btn" type="submit">{t.contact.submit}</button>
							<div class="form-msg" role="status" aria-live="polite"></div>
						</form>
					</div>
				</section>
			</main>

			<footer class="footer"><div class="footer-inner"><span>© <span data-current-year>2026</span> {t.footer.company}</span><span>{t.footer.scope}</span></div></footer>
		</div>

		<script is:inline define:vars={{ themeCopy: t.theme, moduleData, planData, contactCopy: t.contact, contactEmail }}>
			const themeSwitch = document.querySelector('[data-theme-switch]');
			const themeTrigger = document.querySelector('.theme-trigger');
			const themeLabel = document.querySelector('[data-theme-label]');
			const themeOptions = Array.from(document.querySelectorAll('.theme-option'));
			const themeOptionLabels = Array.from(document.querySelectorAll('[data-theme-option-label]'));
			const languageSwitch = document.querySelector('[data-language-switch]');
			const languageTrigger = document.querySelector('.language-trigger');
			const currentYear = document.querySelector('[data-current-year]');
			const themeModes = ['system', 'light', 'dark'];
			const systemThemeQuery = window.matchMedia('(prefers-color-scheme: light)');

			if (currentYear) currentYear.textContent = String(new Date().getFullYear());

			function themeText(mode) {
				return mode === 'light' ? themeCopy.light : mode === 'dark' ? themeCopy.dark : themeCopy.system;
			}

			function resolveTheme(mode) {
				if (mode === 'system') return systemThemeQuery.matches ? 'light' : 'dark';
				return mode === 'light' ? 'light' : 'dark';
			}

			function setTheme(mode, persist = true) {
				const themeMode = themeModes.includes(mode) ? mode : 'system';
				const light = resolveTheme(themeMode) === 'light';
				document.documentElement.dataset.theme = light ? 'light' : 'dark';
				document.documentElement.dataset.themeMode = themeMode;
				themeTrigger?.setAttribute('aria-label', themeCopy.current.replace('{{theme}}', themeText(themeMode)));
				if (themeLabel) themeLabel.textContent = themeText(themeMode);
				themeOptionLabels.forEach((label) => { label.textContent = themeText(label.dataset.themeOptionLabel); });
				themeOptions.forEach((option) => {
					const selected = option.dataset.themeOption === themeMode;
					option.classList.toggle('active', selected);
					option.setAttribute('aria-selected', String(selected));
				});
				if (persist) localStorage.setItem('qishu-theme', themeMode);
			}

			function setSwitchOpen(target, open) {
				target?.classList.toggle('open', open);
				target?.querySelector('.select-trigger')?.setAttribute('aria-expanded', String(open));
			}

			function renderModule(key) {
				const data = moduleData[key] || moduleData.hardware;
				document.querySelectorAll('.tab').forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.module === key)));
				document.getElementById('module-copy').textContent = data.copy;
				document.getElementById('screen-label').textContent = data.label;
				document.getElementById('screen-status').textContent = data.status;
				document.getElementById('module-flow').innerHTML = data.flow.map(([label, text]) => `<div class="flow-item"><span>${label}</span><strong>${text}</strong></div>`).join('');
				document.getElementById('module-grid').innerHTML = data.grid.map(([title, text]) => `<div class="mini"><strong>${title}</strong><span>${text}</span></div>`).join('');
			}

			function renderPlan(key) {
				const data = planData[key] || planData.starter;
				document.querySelectorAll('.switch button').forEach((button) => button.classList.toggle('active', button.dataset.plan === key));
				document.getElementById('plan-price').textContent = data[1];
				document.getElementById('plan-desc').textContent = data[2];
				document.getElementById('plan-list').innerHTML = data[3].map((item) => `<li>${item}</li>`).join('');
			}

			setTheme(localStorage.getItem('qishu-theme') || 'system');
			themeTrigger?.addEventListener('click', () => {
				const open = !themeSwitch.classList.contains('open');
				setSwitchOpen(themeSwitch, open);
				setSwitchOpen(languageSwitch, false);
			});
			themeOptions.forEach((option) => option.addEventListener('click', () => {
				setTheme(option.dataset.themeOption);
