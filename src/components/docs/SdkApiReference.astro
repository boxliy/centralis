	write: isChinese ? '把已经构建好的字节按分片、超时、取消和流控规则写入设备。' : 'Writes built bytes to a device with chunking, timeout, cancellation, and flow-control rules.',
	receive: isChinese ? '把设备回包接入监听器或查询分发器，用于状态、电量、型号等查询。' : 'Routes device responses into listeners or query dispatchers for status, battery, model, and similar queries.',
	ble: isChinese ? '处理 BLE 特征值选择、MTU 分片、credit 通知和 fallback 写入。' : 'Handles BLE characteristic selection, MTU chunking, credit notifications, and fallback writes.',
	esc: isChinese ? '生成 ESC/Boxliy 基础指令，适合小票、便携打印机和支持 ESC 的机型。' : 'Builds ESC/Boxliy commands for receipt, portable, and ESC-compatible printers.',
	tspl: isChinese ? '生成 TSPL 标签指令，适合需要纸张尺寸、坐标、条码和二维码的标签模板。' : 'Builds TSPL label commands for templates with paper size, coordinates, barcodes, and QR codes.',
	cpcl: isChinese ? '生成 CPCL 标签指令，适合 CPCL 机型的页面、文字、线条、条码和图片。' : 'Builds CPCL label commands for page setup, text, lines, barcodes, and images.',
	linEsc: isChinese ? '在 ESC 基础上增加 Lin8inch 遥测、介质、配网和光栅传输相关命令。' : 'Adds Lin8inch telemetry, media, provisioning, and raster transport commands on top of ESC.',
