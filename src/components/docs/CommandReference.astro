const rows = protocol !== 'overview' && family ? protocolData[protocol]?.[family] ?? [] : [];
---

{protocol === 'overview' ? (
	<section>
		<h2>{copy.overviewTitle}</h2>
		<p>{copy.overviewText}</p>
		<table>
			<thead>
				<tr>
					<th>{copy.protocol}</th>
					<th>{copy.family}</th>
					<th>{copy.builder}</th>
					<th>{copy.coverage}</th>
				</tr>
			</thead>
			<tbody>
				{overviewRows.map((row) => (
					<tr>
						<td>{row.protocol}</td>
						<td>{row.family}</td>
						<td><code>{row.builder}</code></td>
						<td>{row.coverage}</td>
					</tr>
				))}
			</tbody>
		</table>
		<p>{copy.firmwareNote}</p>
	</section>
) : family ? (
	<section>
		<h2>{familyNames[family]} {copy.commandTitle}</h2>
		<p>{copy.firmwareNote}</p>
		<table>
			<thead>
				<tr>
					<th>{copy.method}</th>
					<th>{copy.command}</th>
					<th>{copy.params}</th>
					<th>{copy.purpose}</th>
					<th>{copy.note}</th>
				</tr>
			</thead>
			<tbody>
				{rows.map((row) => (
					<tr>
						<td><code>{row.method}</code><br /><small>{row.group}</small></td>
						<td><code>{row.command}</code></td>
						<td>{row.params}</td>
						<td>{row.purpose}</td>
						<td>{row.note ?? '-'}</td>
					</tr>
				))}
			</tbody>
		</table>
	</section>
) : null}
