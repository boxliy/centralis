---
type Protocol = 'overview' | 'esc' | 'tspl' | 'cpcl';
type Family = 'boxliy' | 'aryten' | 'lin8inch';

type CommandRow = {
	group: string;
	method: string;
	command: string;
	params: string;
	purpose: string;
	note?: string;
};

interface Props {
	protocol: Protocol;
	family?: Family;
}

const { protocol, family } = Astro.props;
const locale = Astro.locals.starlightRoute.locale || 'root';
const isZhHans = locale === 'zh-hans';
const isZhHant = locale === 'zh-hant';
const isChinese = isZhHans || isZhHant;

const copy = {
	overviewTitle: isChinese ? '指令族关系' : 'Command family model',
	overviewText: isChinese
		? 'NIB 的指令不是单一列表，而是先按协议分层，再按 Family 区分机型扩展。集成时先确认机器支持的协议，再选择对应 Family 的构建器。'
		: 'NIB commands are organized by protocol first, then by family. Confirm the protocol supported by the printer firmware before choosing the matching family builder.',
	protocol: isChinese ? '协议' : 'Protocol',
	family: isChinese ? 'Family' : 'Family',
	builder: isChinese ? '构建器' : 'Builder',
	coverage: isChinese ? '覆盖范围' : 'Coverage',
	commandTitle: isChinese ? '命令清单' : 'Command list',
	method: isChinese ? 'SDK 方法' : 'SDK method',
	command: isChinese ? '实际指令' : 'Emitted command',
	params: isChinese ? '参数' : 'Parameters',
	purpose: isChinese ? '作用' : 'Purpose',
	note: isChinese ? '返回 / 备注' : 'Response / notes',
	inheritBoxliy: isChinese ? '继承 Boxliy 的公开命令。' : 'Inherits the public Boxliy command surface.',
	firmwareNote: isChinese
		? '具体机器支持哪些协议、Family 和参数值，需要以目标机器固件为准；机器支持列表请联系开发人员或客服确认。'
		: 'The supported protocols, families, and parameter values depend on the target firmware. Ask engineering or support for the printer support list.',
	noCpclLin8inch: isChinese ? '当前 NIB 没有 Lin8inch CPCL 构建器。' : 'NIB does not currently expose a Lin8inch CPCL builder.',
};

const familyNames: Record<Family, string> = {
	boxliy: 'Boxliy',
	aryten: 'Aryten',
	lin8inch: 'Lin8inch',
};

const group = {
	layout: isChinese ? '打印与版面' : 'Print and layout',
	image: isChinese ? '图片与图形' : 'Images and graphics',
	media: isChinese ? '纸张 / 介质' : 'Paper and media',
	status: isChinese ? '状态查询' : 'Status queries',
	device: isChinese ? '设备信息' : 'Device information',
	settings: isChinese ? '设备设置' : 'Device settings',
	composite: isChinese ? '组合方法 / 别名' : 'Composites and aliases',
};

const escBoxliy: CommandRow[] = [
	{ group: group.layout, method: 'reset()', command: '1B 40', params: '-', purpose: isChinese ? '初始化 ESC 打印机状态。' : 'Initializes ESC printer state.' },
	{ group: group.layout, method: 'newLine()', command: '0A', params: '-', purpose: isChinese ? '输出换行。' : 'Prints a line feed.', note: isChinese ? 'Java SDK 暴露。' : 'Exposed by the Java SDK.' },
	{ group: group.layout, method: 'feed(lines) / lineRow(rows)', command: '1B 64 {lines}', params: isChinese ? 'lines: 走纸行数。' : 'lines: number of feed lines.', purpose: isChinese ? '按行走纸。' : 'Feeds by line count.', note: isChinese ? 'Java SDK 暴露；TypeScript 当前使用 lineDot。' : 'Exposed by Java; TypeScript currently uses lineDot.' },
	{ group: group.layout, method: 'lineDot(dot)', command: '1B 4A {dot}', params: isChinese ? 'dot: 走纸点数。' : 'dot: feed distance in dots.', purpose: isChinese ? '按点数正向走纸。' : 'Feeds forward by dots.' },
	{ group: group.layout, method: 'backLineDot(dot)', command: '10 FF 81 {dot}', params: isChinese ? 'dot: 回退点数。' : 'dot: reverse feed distance in dots.', purpose: isChinese ? '按点数反向走纸。' : 'Feeds backward by dots.' },
	{ group: group.layout, method: 'location(loc)', command: '1B 61 {loc}', params: isChinese ? 'loc: 对齐值。' : 'loc: alignment value.', purpose: isChinese ? '设置打印对齐方式。' : 'Sets text alignment.' },
	{ group: group.layout, method: 'line(x, y)', command: '00 01 {x} {y}', params: isChinese ? 'x/y: 线段参数。' : 'x/y: line parameters.', purpose: isChinese ? '写入 Boxliy 线条指令。' : 'Writes the Boxliy line command.', note: isChinese ? 'TypeScript SDK 暴露。' : 'Exposed by TypeScript.' },
	{ group: group.layout, method: 'cut()', command: '1D 56 00', params: '-', purpose: isChinese ? '执行切纸。' : 'Cuts paper.' },
	{ group: group.layout, method: 'lineDotCut()', command: '1D 56 42 01', params: '-', purpose: isChinese ? '走纸后切纸。' : 'Feeds a short distance and cuts.' },
	{ group: group.layout, method: 'position()', command: '1D 0C', params: '-', purpose: isChinese ? '定位标签或当前位置。' : 'Positions the current label or media.' },
	{ group: group.image, method: 'image(...)', command: '1D 76 30 {mode} {widthL} {widthH} {heightL} {heightH} {bitmap}', params: isChinese ? 'image、threshold、reverse、compress、mode。' : 'image, threshold, reverse, compress, mode.', purpose: isChinese ? '发送 ESC 光栅图片。' : 'Sends an ESC raster image.', note: isChinese ? '压缩模式使用 1F 00 头。灰度位图见 Lin8inch。' : 'Compressed mode uses the 1F 00 header. Grayscale is listed under Lin8inch.' },
	{ group: group.media, method: 'thickness(level) / line(thickness)', command: '10 FF 10 00 {level}', params: isChinese ? 'level: 打印浓度或线条厚度等级。' : 'level: density or line thickness level.', purpose: isChinese ? '设置浓度/厚度类参数。' : 'Sets density/thickness-like parameter.' },
	{ group: group.media, method: 'learnLabelGap()', command: '10 FF 03', params: '-', purpose: isChinese ? '触发标签间隙学习。' : 'Starts label gap learning.' },
	{ group: group.media, method: 'paperType(type)', command: '10 FF 10 03 {type}', params: isChinese ? 'type: 纸张类型枚举。' : 'type: paper type enum.', purpose: isChinese ? '设置纸张类型。' : 'Sets paper type.' },
	{ group: group.status, method: 'queryBatteryLevel() / batteryVolume()', command: '10 FF 50 F1', params: '-', purpose: isChinese ? '查询电量。' : 'Queries battery level.' },
	{ group: group.status, method: 'queryStatus() / state() / status()', command: '10 FF 40 / 10 FF FE 20', params: '-', purpose: isChinese ? '查询设备状态。' : 'Queries printer status.', note: isChinese ? '不同 SDK 版本中 state 的底层指令存在差异，按目标语言源码为准。' : 'The state command differs between SDK versions; follow the source for the target language.' },
	{ group: group.device, method: 'queryDeviceInfo() / info()', command: '10 FF 70', params: '-', purpose: isChinese ? '查询设备信息。' : 'Queries device information.' },
	{ group: group.device, method: 'queryModel() / model()', command: '10 FF 20 F0', params: '-', purpose: isChinese ? '查询型号。' : 'Queries model.' },
	{ group: group.device, method: 'queryFirmwareVersion() / version()', command: '10 FF 20 F1', params: '-', purpose: isChinese ? '查询固件版本。' : 'Queries firmware version.' },
	{ group: group.device, method: 'printerVersion()', command: '10 FF 20 FF / 10 FF 20 F1', params: '-', purpose: isChinese ? '查询打印机版本。' : 'Queries printer version.', note: isChinese ? 'Java 与 TypeScript 当前输出不同。' : 'Java and TypeScript currently emit different bytes.' },
	{ group: group.device, method: 'querySerialNumber() / sn()', command: '10 FF 20 F2', params: '-', purpose: isChinese ? '查询序列号。' : 'Queries serial number.' },
	{ group: group.device, method: 'name()', command: '10 FF 30 11', params: '-', purpose: isChinese ? '查询蓝牙名称或设备名称。' : 'Queries Bluetooth/device name.' },
	{ group: group.device, method: 'mac()', command: '10 FF 30 12', params: '-', purpose: isChinese ? '查询 MAC 地址。' : 'Queries MAC address.' },
	{ group: group.device, method: 'nn()', command: '10 FF 20 F9', params: '-', purpose: isChinese ? '查询设备 NN 信息。' : 'Queries NN device information.', note: isChinese ? 'TypeScript SDK 暴露。' : 'Exposed by TypeScript.' },
	{ group: group.settings, method: 'enable()', command: '10 FF FE 01', params: '-', purpose: isChinese ? '使能设备或打印任务。' : 'Enables the device or print task.' },
	{ group: group.settings, method: 'stopJob()', command: '10 FF FE 45', params: '-', purpose: isChinese ? '停止当前任务。' : 'Stops the current job.' },
	{ group: group.settings, method: 'wakeup(length)', command: '00 ... 00', params: isChinese ? 'length: 默认 12 个 0 字节。' : 'length: defaults to 12 zero bytes.', purpose: isChinese ? '唤醒设备。' : 'Wakes the device.' },
	{ group: group.settings, method: 'setBTType()', command: '1F B2 10', params: '-', purpose: isChinese ? '设置蓝牙类型或传输模式。' : 'Sets Bluetooth type or transport mode.' },
	{ group: group.settings, method: 'setShutdownTime(time)', command: '10 FF 12 {timeH} {timeL}', params: isChinese ? 'time: 自动关机时间。' : 'time: auto-shutdown value.', purpose: isChinese ? '设置自动关机时间。' : 'Sets auto-shutdown time.', note: isChinese ? 'TypeScript SDK 暴露。' : 'Exposed by TypeScript.' },
	{ group: group.settings, method: 'getShutdownTime()', command: '10 FF 13', params: '-', purpose: isChinese ? '查询自动关机时间。' : 'Queries auto-shutdown time.', note: isChinese ? 'TypeScript SDK 暴露。' : 'Exposed by TypeScript.' },
	{ group: group.settings, method: 'setCurrentTime(options)', command: '10 FF 14 02 {sec} {min} {hour} {day} {week} {month} {year}', params: isChinese ? '时间字段，缺省为 0。' : 'Time fields, defaulting to 0.', purpose: isChinese ? '设置设备当前时间。' : 'Sets current device time.', note: isChinese ? 'TypeScript SDK 暴露。' : 'Exposed by TypeScript.' },
	{ group: group.composite, method: 'raw(...)', command: isChinese ? '调用方提供的原始 bytes 或文本。' : 'Caller-provided raw bytes or text.', params: isChinese ? 'bytes/template。' : 'bytes/template.', purpose: isChinese ? '逃生口：发送 SDK 尚未封装的指令。' : 'Escape hatch for commands not wrapped by the SDK.' },
];

const escAryten: CommandRow[] = [
	{ group: group.composite, method: 'EscAryten', command: copy.inheritBoxliy, params: '-', purpose: isChinese ? '继承 ESC Boxliy 的命令能力。' : 'Inherits ESC Boxliy commands.' },
	{ group: group.media, method: 'paperTypeQ3(type)', command: '10 FF 84 {type}', params: isChinese ? 'type: Q3 纸张类型。' : 'type: Q3 paper type.', purpose: isChinese ? '设置 Q3 纸张类型。' : 'Sets Q3 paper type.' },
	{ group: group.media, method: 'getPaperTypeQ3()', command: '10 FF 85', params: '-', purpose: isChinese ? '查询 Q3 纸张类型。' : 'Queries Q3 paper type.' },
];

